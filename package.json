{
  "name": "read-and-listen-book",
  "version": "0.8.4",
  "description": "听见书页 · PageEcho，Windows 听书与同步伴读桌面应用",
  "private": true,
  "license": "MIT",
  "author": "Yuff1010",
  "homepage": "https://github.com/Yuff1010/PageEcho",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yuff1010/PageEcho.git"
  },
  "bugs": {
    "url": "https://github.com/Yuff1010/PageEcho/issues"
  },
  "type": "module",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "runtime:install": "node node_modules/electron/install.js",
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit:python": "tsx scripts/maintenance/audit-python-dependencies.ts",
    "asr:patch": "python -B -X utf8 python/build_security_component.py",
    "workspace:inventory": "tsx scripts/maintenance/workspace-inventory.ts",
    "workspace:storage": "tsx scripts/maintenance/generated-storage.ts",
    "test": "tsx --test tests/unit/*.test.ts",
    "test:worker": "tsx --test tests/worker/*.test.ts && python -X utf8 -m unittest discover -s python -p test_*.py",
    "test:desktop": "playwright test",
    "test:desktop:critical": "playwright test tests/desktop/player.spec.ts tests/desktop/normal-reading.spec.ts tests/desktop/progressive-playback.spec.ts tests/desktop/transcription-progress-ui.spec.ts --forbid-only --workers=1 --retries=0",
    "test:installer:signature": "tsx --test tests/build/installer-signature.test.ts",
    "test:dev": "tsx tests/dev/smoke.ts",
    "check": "npm run typecheck && npm run lint && npm run test && npm run format:check",
    "verify": "tsx scripts/verify.ts",
    "asr:prepare": "tsx scripts/asr/prepare-asr-samples.ts",
    "asr:validate": "tsx scripts/validate-asr-results.ts",
    "asr:desktop": "tsx tests/model/desktop-smoke.ts",
    "asr:desktop:prepare": "tsx scripts/prepare-worker-desktop.ts",
    "asr:worker": "tsx scripts/test-asr-worker.ts",
    "asr:component": "tsx scripts/asr/prepare-asr-component.ts",
    "asr:bundle": "tsx scripts/asr/build-asr-component.ts",
    "asr:app": "tsx tests/model/app-transcription.ts",
    "asr:soak": "tsx tests/model/listening-soak.ts",
    "asr:reference": "tsx tests/model/public-reference.ts",
    "quality:compare": "python -B -X utf8 scripts/compare-quality-reference.py",
    "test:film:app": "tsx tests/model/film-app.ts",
    "test:audiobook": "tsx tests/model/audiobook-playback.ts",
    "test:audiobook:long": "tsx tests/model/long-audiobook.ts",
    "test:audiobook:lifecycle": "tsx tests/model/electron-lifecycle-smoke.ts",
    "test:audiobook:input": "tsx tests/model/long-input-smoke.ts",
    "test:audiobook:audit": "tsx scripts/audit-long-playback.ts",
    "test:source": "tsx tests/model/source-ting13.ts",
    "test:source:wikisource": "tsx tests/model/source-wikisource.ts",
    "plugin:pack": "tsx scripts/build/pack-source-plugin.ts",
    "test:source:app": "tsx tests/model/source-app.ts",
    "test:source:playback": "tsx tests/model/source-playback.ts",
    "test:source:preparation": "tsx tests/model/source-preparation.ts",
    "test:original:app": "tsx tests/model/original-app.ts",
    "test:original:online": "tsx tests/model/original-online.ts",
    "test:original:rematch": "tsx tests/model/original-rematch.ts",
    "test:reading:tools": "tsx tests/model/reading-tools.ts",
    "test:transcript:search": "tsx tests/model/transcript-search.ts",
    "test:original:sequence": "tsx tests/model/original-sequence.ts",
    "test:original:sequence:rematch": "tsx tests/model/original-sequence-rematch.ts",
    "asr:original:review": "tsx scripts/prepare-original-review.ts",
    "asr:original:review:validate": "python -B -X utf8 python/review_original.py",
    "original:prepare:epub": "tsx scripts/prepare-original-epub.ts",
    "test:original:epub": "tsx tests/model/original-epub.ts",
    "pack:preview": "tsx scripts/build/package-preview.ts",
    "pack:installer": "tsx scripts/build/package-installer-preview.ts",
    "pack:handoff": "tsx scripts/build/package-handoff.ts",
    "build:preview": "tsx scripts/build/build-preview.ts",
    "build": "npm run typecheck && electron-vite build",
    "pack:win": "npm run build && electron-builder --win --x64 --dir",
    "dist:win": "npm run build && electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "@xmldom/xmldom": "0.8.15",
    "cheerio": "1.2.0",
    "opencc-js": "1.4.2",
    "quickjs-emscripten": "0.32.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "unzipper": "0.12.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.9.1",
    "electron-builder": "26.15.3",
    "electron-vite": "6.0.0",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4"
  },
  "overrides": {
    "minimatch@^10.0.0": "11.0.4"
  }
}
